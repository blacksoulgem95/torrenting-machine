#!/sbin/openrc-run
# Avvia lo stack seedbox (compose.yaml) sul servizio podman rootful.
# Configurazione in /etc/conf.d/seedbox.

name="Seedbox stack"
description="qBittorrent, *arr, Seerr e Nginx Proxy Manager su podman"

: "${SEEDBOX_DIR:=/home/seedbox/infra}"
: "${DOCKER_HOST:=unix:///run/podman/podman.sock}"
export DOCKER_HOST

depend() {
	# SEEDBOX_STORAGE=rclone-b2 in /etc/conf.d/seedbox quando /data è su B2
	need podman net wg-quick.wg0 $SEEDBOX_STORAGE
	after wg-quick.wg0
}

_compose() {
	docker compose --project-directory "$SEEDBOX_DIR" -f "$SEEDBOX_DIR/compose.yaml" "$@"
}

start_pre() {
	# il servizio podman crea il socket poco dopo l'avvio
	local i=0
	while [ ! -S "${DOCKER_HOST#unix://}" ] && [ $i -lt 30 ]; do
		sleep 1; i=$((i + 1))
	done
	[ -S "${DOCKER_HOST#unix://}" ] || { eerror "Socket podman non disponibile"; return 1; }
	# propagazione dei mount verso i container (bind /data:rslave)
	mount --make-rshared /
	if [ -n "$SEEDBOX_STORAGE" ] && ! mountpoint -q /data; then
		eerror "/data non è montato ($SEEDBOX_STORAGE): non avvio lo stack"
		return 1
	fi
	if [ ! -d /data/torrents ]; then
		ewarn "/data/torrents non esiste: il disco dati è montato?"
	fi
}

start() {
	ebegin "Starting $name"
	_compose up -d --remove-orphans
	eend $?
}

stop() {
	ebegin "Stopping $name"
	_compose stop
	eend $?
}

status() {
	_compose ps
}
