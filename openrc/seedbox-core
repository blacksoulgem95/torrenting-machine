#!/sbin/openrc-run
# Avvia lo stack core (core.yaml): NPM, Prowlarr, Seerr e pagina di stato.
# Non dipende dal mount /data, quindi resta su quando rclone-b2 si riavvia.

name="Seedbox core"
description="Nginx Proxy Manager, Prowlarr, Seerr e pagina di stato su podman"

: "${SEEDBOX_DIR:=/home/seedbox/infra}"
: "${DOCKER_HOST:=unix:///run/podman/podman.sock}"
export DOCKER_HOST

depend() {
	need podman net
	after wg-quick.wg0
}

_compose() {
	docker compose --project-directory "$SEEDBOX_DIR" -f "$SEEDBOX_DIR/core.yaml" "$@"
}

start_pre() {
	# il servizio podman crea il socket poco dopo l'avvio
	local i=0
	while [ ! -S "${DOCKER_HOST#unix://}" ] && [ $i -lt 30 ]; do
		sleep 1; i=$((i + 1))
	done
	[ -S "${DOCKER_HOST#unix://}" ] || { eerror "Socket podman non disponibile"; return 1; }
	# rete condivisa con lo stack seedbox
	podman network exists seedbox || podman network create seedbox >/dev/null
}

start() {
	ebegin "Starting $name"
	_compose up -d --remove-orphans
	eend $?
}

stop() {
	ebegin "Stopping $name"
	_compose stop --timeout 60
	eend $?
}

status() {
	_compose ps
}
