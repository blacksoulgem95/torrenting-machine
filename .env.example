# Copiato in .env da setup.sh (che genera le password se vuote).
PUID=1000
PGID=1000
TZ=Europe/Rome

# Radice di download + libreria (stesso filesystem → hardlink)
DATA_ROOT=/data

# Dominio base per i proxy host di NPM: {software}.casa.local
BASE_DOMAIN=casa.local

# Nginx Proxy Manager (admin su http://<ip>:81 o http://npm.casa.local)
NPM_ADMIN_EMAIL=admin@casa.local
NPM_ADMIN_PASSWORD=

# qBittorrent WebUI
QBIT_USER=admin
QBIT_PASS=

# File Browser (fm.casa.local), utente admin. setup.sh la genera se vuota.
FILEBROWSER_USER=admin
FILEBROWSER_PASS=

# ProtonVPN NAT-PMP gateway
NATPMP_GATEWAY=10.2.0.1

# Profili opzionali (es. "readarr")
COMPOSE_PROFILES=

# --- Backblaze B2 (API S3) montato su $DATA_ROOT con rclone -----------------
# Lascia B2_BUCKET vuoto per usare il disco locale.
# Chiave: B2 → Application Keys (keyID = access key, applicationKey = secret)
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET=
# Sottocartella nel bucket (opzionale)
B2_PATH=seedbox
# Endpoint dalla pagina del bucket, es. s3.eu-central-003.backblazeb2.com
B2_ENDPOINT=
# Regione = parte centrale dell'endpoint, es. eu-central-003
B2_REGION=
# Cache locale rclone (VFS) e download incompleti di qBittorrent (disco locale)
RCLONE_CACHE_DIR=/srv/seedbox/rclone-cache
RCLONE_CACHE_SIZE=20G
LOCAL_INCOMPLETE=/srv/seedbox/incomplete
# Cifratura rclone (crypt): nomi e contenuti dei file su B2 sono cifrati.
# setup.sh le genera se vuote. SALVALE ALTROVE: se le perdi, i dati su B2 sono persi.
B2_CRYPT_PASSWORD=
B2_CRYPT_PASSWORD2=
# disco locale dedicato (incompleti + cache rclone): i servizi non partono se non è montato
LOCAL_DISK=/srv/seedbox
